# Orquestrador 360 — Configuration
# Copy this file to .env and fill in your actual values. Never commit .env.

# Anthropic API key (required, server-side only — never sent to or accepted from clients)
# Get yours from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of API keys THIS service accepts from its own clients
# (dashboard, CLI, CI, the "Proyecto Actas" Apps Script). Generate each with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# These are NOT Anthropic keys — do not put your ANTHROPIC_API_KEY here.
# Use a SEPARATE key per client so any one of them can be revoked independently
# (e.g. one for the dashboard, one for the Apps Script calling /brain/ingest-acta).
APP_API_KEYS=replace-with-a-long-random-key,optionally-a-second-one-for-apps-script

# MAP server port
PORT=3001

# Master Orchestrator port
ORCHESTRATOR_PORT=3000

# Environment mode
NODE_ENV=development

# Where projects.json / activity.log / workflows.json are written.
# On serverless/ephemeral hosts this MUST point at a persistent volume or the
# state is lost on every cold start/redeploy.
STORAGE_DIR=./storage

# Path to the ia-hybrid-teams `agents/` folder, if you want to override the
# bundled copy at src/agents/spec-kit-agents/ (e.g. to pick up edits live
# instead of re-copying files).
# SPEC_KIT_AGENTS_DIR=/absolute/path/to/ia-hybrid-teams/agents

# Frontend URL (for CORS, if restricting origins later)
FRONTEND_URL=http://localhost:5173
