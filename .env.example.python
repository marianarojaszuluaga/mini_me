# Orquestrador 360 — Configuration (Python/FastAPI backend)
# Copy this file to .env and fill in your actual values. Never commit .env.
#
# This backend was rewritten from Node/Express to Python/FastAPI
# (SPEC_JARVIS.md §8.0) — the environment variables below are UNCHANGED from
# the Node era. Same names, same meaning, same values. Read via
# app/core/config.py (pydantic-settings) instead of process.env.

# Anthropic API key (required, server-side only — never sent to or accepted from clients)
# Get yours from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of API keys THIS service accepts from its own clients
# (dashboard, CLI, CI, the "Proyecto Actas" Apps Script). Generate each with:
# python -c "import secrets; print(secrets.token_hex(32))"
# These are NOT Anthropic keys — do not put your ANTHROPIC_API_KEY here.
# Use a SEPARATE key per client so any one of them can be revoked independently
# (e.g. one for the dashboard, one for the Apps Script calling /brain/ingest-acta).
APP_API_KEYS=replace-with-a-long-random-key,optionally-a-second-one-for-apps-script

# MAP server port (uvicorn)
PORT=3001

# Master Orchestrator port
ORCHESTRATOR_PORT=3000

# Environment mode. NODE_ENV is read for drop-in compatibility with existing
# deploys; ENVIRONMENT is the Python-idiomatic alias. If both are set,
# ENVIRONMENT wins (see app/core/config.py Settings.environment).
NODE_ENV=development
# ENVIRONMENT=development

# Where projects.json / activity-log.json / workflows.json are written.
# Only used when Redis (below) is NOT configured. On serverless/ephemeral
# hosts this must point at a persistent volume, or state is lost between
# invocations — irrelevant if UPSTASH_REDIS_REST_* is set.
STORAGE_DIR=./storage

# Vercel deploy ONLY: Redis credentials for persistent storage across
# serverless invocations. Add a Redis integration from the Vercel Marketplace
# (Storage tab > Marketplace Database Providers > Upstash/Redis) — it injects
# these automatically, usually under a store-specific prefix (handled by
# app/core/storage.py's suffix matching, same as store.js). Without them, the
# app still runs but every project/decision/alert is lost as soon as the
# function cold-starts again.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Master Orchestrator only: public URL of the deployed MAP service (this repo
# deploys MAP + Orchestrator as ONE Vercel project under /map and
# /orchestrator prefixes — see vercel.json). Leave unset for local dev.
# MAP_URL=https://your-deployment.vercel.app/map

# Path to the ia-hybrid-teams `agents/` folder, if you want to override the
# bundled copy at src/agents/spec-kit-agents/ (e.g. to pick up edits live
# instead of re-copying files).
# SPEC_KIT_AGENTS_DIR=/absolute/path/to/ia-hybrid-teams/agents

# Path to the external agents folder (milestone-writer, dod-definer,
# capacity-reconciler), if overriding the bundled copy at
# src/agents/external-agents/.
# EXTERNAL_AGENTS_DIR=/absolute/path/to/external-agents

# Frontend URL (for CORS, if restricting origins later)
FRONTEND_URL=http://localhost:5173
